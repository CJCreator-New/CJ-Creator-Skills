{
  "name": "orders-app (example)",
  "targets": {
    "web": {
      "baseUrl": "http://localhost:4173"
    },
    "mobile-web": {
      "baseUrl": "http://localhost:4173"
    },
    "android": {
      "packageName": "com.example.orders",
      "binary": "builds/orders.apk",
      "versionName": "1.0.0",
      "buildNumber": "1",
      "binarySha256": "<sha256 from the build handover, optional>",
      "flows": {
        "sign-in-and-list": "flows/sign-in-and-list.yaml"
      },
      "devices": [
        "emulator-5554"
      ]
    },
    "ios": {
      "bundleId": "com.example.orders",
      "binary": "builds/Orders.app",
      "versionName": "1.0.0",
      "buildNumber": "1",
      "flows": {
        "sign-in-and-list": "flows/sign-in-and-list.yaml"
      }
    }
  },
  "start": "node server.mjs",
  "startEnv": {
    "PORT": "4173"
  },
  "startTimeoutSeconds": 30,
  "healthUrl": "http://localhost:4173/health",
  "db": {
    "engine": "sqlite",
    "name": "test_orders"
  },
  "allowlist": {
    "hosts": [
      "localhost",
      "sandbox.mail.example.test"
    ],
    "packageNames": [
      "com.example.orders"
    ],
    "bundleIds": [
      "com.example.orders"
    ],
    "dbNamePattern": "^(test|qa)_"
  },
  "authorization": null,
  "allowReset": false,
  "timezones": [
    "UTC"
  ],
  "loadLimits": {
    "maxVirtualUsers": 4,
    "maxDurationSeconds": 30,
    "maxRequestsPerSecond": 20
  },
  "viewports": {
    "desktop": {
      "width": 1280,
      "height": 800
    },
    "phone": {
      "width": 390,
      "height": 844
    },
    "narrow": {
      "width": 320,
      "height": 640
    }
  },
  "mobileProjects": {
    "android": "app/android"
  },
  "clock": {
    "fixedTime": "2026-01-15T10:00:00Z"
  },
  "integrations": {
    "payments": {
      "mode": "double"
    },
    "email": {
      "mode": "live",
      "sandboxUrl": "https://sandbox.mail.example.test"
    }
  },
  "stops": {
    "infrastructureRate": 0.3,
    "minSample": 3
  },
  "budget": {
    "maxMinutes": 120,
    "maxRuns": 500,
    "maxTokens": 2000000
  },
  "evidence": {
    "keepRuns": 10,
    "maxMegabytes": 500
  },
  "browser": {
    "playwrightModule": "node_modules/playwright",
    "axeModule": "node_modules/axe-core"
  }
}

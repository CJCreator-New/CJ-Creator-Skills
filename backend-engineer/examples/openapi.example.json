{
  "openapi": "3.0.3",
  "info": { "title": "Expenses (example)", "version": "0.1.0" },
  "paths": {
    "/expenses/{id}": {
      "get": {
        "operationId": "getExpenseReport",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "The report, if the caller owns it or is its approver." },
          "401": { "description": "Not authenticated." },
          "403": { "description": "Not allowed to read this report." },
          "404": { "description": "No such report for this caller." }
        }
      }
    },
    "/expenses/{id}/submit": {
      "post": {
        "operationId": "submitExpenseReport",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "The report is now submitted." },
          "401": { "description": "Not authenticated." },
          "403": { "description": "Not the owner of this report." },
          "409": { "description": "The report is not in draft." },
          "422": { "description": "Validation failed, for example a missing receipt." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } }
  }
}
